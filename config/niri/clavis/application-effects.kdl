// Managed by Clavis.
window-rule {
    exclude app-id="^org[.]quickshell$";
    exclude title="^(clavis-control-center(-[a-z-]+)?|clavis-file-picker)$";
    opacity 0.92;
    background-effect {
        blur true;
        xray false;
        blur-passes 3;
    };
};
window-rule {
    match is-focused=false;
    exclude app-id="^org[.]quickshell$";
    exclude title="^(clavis-control-center(-[a-z-]+)?|clavis-file-picker)$";
    opacity 0.8;
};
