#!/bin/bash
set -euo pipefail
# Fcitx normally discovers the session's :0 display only. Register the
# additional chat display whenever either it or the input method starts.
if [[ -S /tmp/.X11-unix/X4 ]]; then
    # Autostart services may run ExecStartPost before Fcitx owns its bus name.
    # Never activate a second input-method process while waiting for that one.
    for _wechat_input_attempt in {1..12}; do
        if wechat_input_result=$(LC_ALL=C /usr/bin/busctl --user --auto-start=no --timeout=2 call \
            org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1 \
            OpenX11Connection s :4 2>&1); then
            exit 0
        fi
        if [[ "$wechat_input_result" == 'Call failed: X11 connection already exists.' ]]; then
            exit 0
        fi
        /usr/bin/sleep 0.25
    done
    printf '%s\n' "$wechat_input_result" >&2
    exit 1
fi
