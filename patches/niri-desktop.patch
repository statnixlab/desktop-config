+                warn!(
+                    output = %self.name.connector,
+                    format = ?self.compositor.format(),
+                    "keeping previous output format after all policy candidates failed"
+                );
+            }
+        }
+
+        self.render_policy = policy;
+        policy.log(
+            &self.name.connector,
+            refresh_millihertz,
+            self.compositor.format(),
+        );
+    }
