[Desktop Entry]
Name=wechat
Name[zh_CN]=微信
Exec="@HOME@/.local/bin/chat-hidpi-launch" wechat %U
TryExec=/opt/wechat/wechat
StartupWMClass=wechat
StartupNotify=true
Terminal=false
Icon=/usr/share/icons/hicolor/512x512/apps/wechat.png
Type=Application
Categories=Utility;
Comment=Wechat Desktop
Comment[zh_CN]=微信桌面版
