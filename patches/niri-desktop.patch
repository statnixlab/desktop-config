+                    if modifiers.is_empty() {
+                        continue;
+                    }
+                    match self
+                        .compositor
+                        .set_format(allocator.clone(), code, modifiers)
+                    {
+                        Ok(()) => {
+                            selected = true;
+                            break 'formats;
+                        }
+                        Err(err) => warn!(
