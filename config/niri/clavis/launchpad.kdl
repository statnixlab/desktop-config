binds {
    // Native niri release bind: press and release Win by itself to toggle Launchpad.
    // Pressing any other key or mouse button while holding Win cancels it,
    // so Win+Tab, Win+Space and other shortcuts are unaffected.
    Super hotkey-overlay-title="应用菜单：单击 Win" {
        release { spawn "qs" "-c" "clavis" "ipc" "call" "launchpad" "toggle"; }
    }
}
